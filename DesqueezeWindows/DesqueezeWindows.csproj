<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Desqueeze</AssemblyName>
    <RootNamespace>DesqueezeWindows</RootNamespace>
    <!-- Generated by generate_icon.py at the repo root, alongside the macOS
         iconset. Conditional so a fresh clone builds before it has been run. -->
    <ApplicationIcon Condition="Exists('Assets\icon.ico')">Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>Chambers &amp; Light LLC</Company>
    <Product>Desqueeze</Product>
    <Copyright>© 2024 Chambers &amp; Light LLC</Copyright>
    <Description>Anamorphic photo de-squeeze tool</Description>
  </PropertyGroup>

</Project>
