<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesqueezeWindows.ViewModels"
        x:Class="DesqueezeWindows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Desqueeze"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="#0D0D0D"
        FontFamily="Segoe UI, Inter, Arial">

  <Window.Styles>

    <Style Selector="Button.muted">
      <Setter Property="Background"      Value="#2A2A2A"/>
      <Setter Property="Foreground"      Value="#F5F0E8"/>
      <Setter Property="BorderBrush"     Value="#444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="14,7"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.muted:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#383838"/>
    </Style>

    <Style Selector="Button.gold">
      <Setter Property="Background"      Value="#C9A84C"/>
      <Setter Property="Foreground"      Value="#0D0D0D"/>
      <Setter Property="BorderBrush"     Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="16,8"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.gold:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E0BC5A"/>
    </Style>
    <Style Selector="Button.gold:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#5A4A1F"/>
    </Style>

    <Style Selector="Button.tab">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#8A8580"/>
      <Setter Property="BorderBrush"     Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="16,7"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E1E"/>
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background"   Value="#C9A84C"/>
      <Setter Property="Foreground"   Value="#0D0D0D"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#8A8580"/>
      <Setter Property="BorderBrush"     Value="#444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="10,5"/>
      <Setter Property="CornerRadius"    Value="4"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A0A0A"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="52,*">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#242424"
            BorderBrush="#333333" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="20,0">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Border Width="22" Height="22" CornerRadius="4" Background="#C9A84C">
            <TextBlock Text="D" FontWeight="Bold" FontSize="13"
                       Foreground="#0D0D0D"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Desqueeze" FontSize="16" FontWeight="SemiBold"
                     Foreground="#F5F0E8" VerticalAlignment="Center"/>
          <TextBlock Text="by Chambers &amp; Light" FontSize="11"
                     Foreground="#8A8580" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="4">
          <Button x:Name="SingleTabButton"
                  Classes="tab active"
                  Content="Single"
                  Click="OnSingleModeClick"/>
          <Button x:Name="BatchTabButton"
                  Classes="tab"
                  Content="Batch"
                  Click="OnBatchModeClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Main content ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="1">

      <!-- ══ SINGLE MODE ══════════════════════════════════════════════════ -->
      <Grid x:Name="SinglePanel"
            ColumnDefinitions="*,220">

        <!-- Preview / drop zone -->
        <Grid Grid.Column="0">

          <!-- Drop zone (no image) -->
          <Border x:Name="DropZone"
                  Background="#0F0F0F"
                  BorderBrush="#2A2A2A"
                  BorderThickness="2"
                  CornerRadius="8"
                  Margin="16"
                  Cursor="Hand">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="14">
              <Border Width="60" Height="60" CornerRadius="30"
                      Background="#1A1A1A" BorderBrush="#333" BorderThickness="1">
                <TextBlock Text="↓" FontSize="30" Foreground="#C9A84C"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Drop an image here" FontSize="16"
                         Foreground="#F5F0E8" HorizontalAlignment="Center"/>
              <TextBlock Text="or click to browse"
                         FontSize="13" Foreground="#8A8580"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="JPEG · PNG · TIFF · HEIC · BMP · WebP"
                         FontSize="11" Foreground="#444"
                         HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <!-- Preview area (with image) -->
          <Grid x:Name="PreviewPanel"
                IsVisible="False"
                RowDefinitions="*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,1,*" Margin="12,12,12,8">

              <!-- Before -->
              <Grid Grid.Column="0" Background="#0F0F0F" RowDefinitions="*,26">
                <Image Grid.Row="0" x:Name="BeforeImage"
                       Stretch="Uniform" Margin="4"/>
                <Border Grid.Row="1" Background="#171717">
                  <TextBlock Text="ORIGINAL" FontSize="10" FontWeight="SemiBold"
                             Foreground="#555" LetterSpacing="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>

              <!-- Divider -->
              <Border Grid.Column="1" Background="#2A2A2A"/>

              <!-- After -->
              <Grid Grid.Column="2" Background="#0F0F0F" RowDefinitions="*,26">
                <Image Grid.Row="0" x:Name="AfterImage"
                       Stretch="Uniform" Margin="4"/>
                <Border Grid.Row="1" Background="#171717">
                  <TextBlock Text="DESQUEEZED" FontSize="10" FontWeight="SemiBold"
                             Foreground="#C9A84C" LetterSpacing="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Grid>

            <!-- Processing indicator -->
            <Border Grid.Row="1" x:Name="ProcessingBar"
                    IsVisible="False"
                    Margin="12,0,12,6" Padding="10,4"
                    Background="#1A1600" CornerRadius="4">
              <TextBlock Text="Processing…" FontSize="12" Foreground="#C9A84C"
                         HorizontalAlignment="Center"/>
            </Border>
          </Grid>
        </Grid>

        <!-- Controls panel -->
        <Border Grid.Column="1"
                Background="#161616"
                BorderBrush="#2A2A2A" BorderThickness="1,0,0,0"
                Padding="16,20,16,16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">

              <TextBlock Text="SQUEEZE FACTOR" FontSize="10" FontWeight="SemiBold"
                         LetterSpacing="2" Foreground="#555"/>

              <ComboBox x:Name="SinglePresetCombo"
                        ItemsSource="{Binding PresetLabels}"
                        SelectedIndex="{Binding PresetIndex}"
                        HorizontalAlignment="Stretch"
                        Background="#242424" Foreground="#F5F0E8"/>

              <Grid x:Name="CustomFactorRow"
                    ColumnDefinitions="Auto,*"
                    IsVisible="False">
                <TextBlock Grid.Column="0" Text="Value:" FontSize="12"
                           Foreground="#8A8580" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         x:Name="CustomFactorBox"
                         Text="{Binding CustomFactor}"
                         Watermark="e.g. 1.78"
                         Background="#242424" Foreground="#F5F0E8"/>
              </Grid>

              <Button Classes="muted" Content="Apply Factor"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Click="OnApplyFactorClick"/>

              <Border Height="1" Background="#222"/>

              <StackPanel x:Name="OutputInfoPanel" Spacing="4" IsVisible="False">
                <TextBlock Text="OUTPUT" FontSize="10" FontWeight="SemiBold"
                           LetterSpacing="2" Foreground="#555"/>
                <TextBlock x:Name="OutputInfoText" FontSize="13"
                           Foreground="#F5F0E8"/>
              </StackPanel>

              <Border x:Name="ErrorPanel"
                      IsVisible="False"
                      Background="#200808" CornerRadius="4" Padding="10,8">
                <TextBlock x:Name="ErrorText"
                           FontSize="12" Foreground="#E07070"
                           TextWrapping="Wrap"/>
              </Border>

              <Button Classes="gold" Content="Export…"
                      x:Name="ExportButton"
                      IsEnabled="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Click="OnExportClick"/>

              <Button Classes="danger" Content="Clear Image"
                      x:Name="ClearButton"
                      IsEnabled="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Click="OnClearClick"/>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ══ BATCH MODE ═══════════════════════════════════════════════════ -->
      <Grid x:Name="BatchPanel"
            IsVisible="False"
            ColumnDefinitions="*,260">

        <!-- Left: file list area -->
        <Grid Grid.Column="0" RowDefinitions="52,*">

          <!-- Toolbar -->
          <Border Grid.Row="0" Background="#161616"
                  BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                  Padding="12,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="8">
              <Button Classes="muted" Content="+ Add Files"
                      Click="OnBatchAddFilesClick"/>
              <Button Classes="muted" Content="+ Add Folder"
                      Click="OnBatchAddFolderClick"/>
              <Border Width="1" Background="#333" Margin="4,10"/>
              <Button Classes="danger" Content="Clear All"
                      x:Name="BatchClearButton"
                      Click="OnBatchClearClick"/>
              <TextBlock x:Name="BatchCountLabel"
                         FontSize="12" Foreground="#555"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
          </Border>

          <!-- Drop target + file list -->
          <Grid Grid.Row="1" x:Name="BatchDropZone"
                Margin="12,8">

            <!-- Empty state -->
            <Border x:Name="BatchEmptyState"
                    Background="#0F0F0F"
                    CornerRadius="8"
                    BorderBrush="#2A2A2A" BorderThickness="2">
              <StackPanel VerticalAlignment="Center"
                          HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="↓" FontSize="40" Foreground="#C9A84C"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Drop images or a folder here"
                           FontSize="15" Foreground="#F5F0E8"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="or use Add Files / Add Folder above"
                           FontSize="12" Foreground="#8A8580"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- File list -->
            <ListBox x:Name="BatchListBox"
                     IsVisible="False"
                     ItemsSource="{Binding BatchItems}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" x:DataType="vm:BatchItemViewModel">
                  <Setter Property="Padding"    Value="0"/>
                  <Setter Property="Margin"     Value="0,2"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <ControlTemplate>
                      <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                  </Setter>
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BatchItemViewModel">
                  <Border Background="#181818" CornerRadius="4"
                          Padding="12,8" Margin="0,1"
                          BorderBrush="#252525" BorderThickness="1">
                    <Grid ColumnDefinitions="22,*,150">
                      <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                 FontSize="13" Foreground="#555"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                 FontSize="13" Foreground="#F5F0E8"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,0,8,0"/>
                      <ComboBox Grid.Column="2"
                                ItemsSource="{Binding PresetLabels}"
                                SelectedIndex="{Binding PresetIndex}"
                                Background="#242424" Foreground="#F5F0E8"
                                FontSize="12" Padding="8,4"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <!-- Right: batch controls -->
        <Border Grid.Column="1"
                Background="#161616"
                BorderBrush="#2A2A2A" BorderThickness="1,0,0,0"
                Padding="16,20,16,16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">

              <TextBlock Text="BULK FACTOR" FontSize="10" FontWeight="SemiBold"
                         LetterSpacing="2" Foreground="#555"/>

              <ComboBox x:Name="BulkPresetCombo"
                        ItemsSource="{Binding PresetLabels}"
                        SelectedIndex="{Binding BulkPresetIndex}"
                        HorizontalAlignment="Stretch"
                        Background="#242424" Foreground="#F5F0E8"/>

              <Grid x:Name="BulkCustomRow"
                    ColumnDefinitions="Auto,*"
                    IsVisible="False">
                <TextBlock Grid.Column="0" Text="Value:" FontSize="12"
                           Foreground="#8A8580" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="BulkCustomBox"
                         Text="{Binding BulkCustomFactor}"
                         Watermark="e.g. 1.78"
                         Background="#242424" Foreground="#F5F0E8"/>
              </Grid>

              <Button Classes="muted" Content="Apply to All"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Click="OnApplyBulkClick"/>

              <Border Height="1" Background="#222"/>

              <!-- Progress -->
              <StackPanel x:Name="BatchProgressPanel" Spacing="8" IsVisible="False">
                <TextBlock x:Name="BatchProgressLabel"
                           FontSize="12" Foreground="#C9A84C"/>
                <ProgressBar x:Name="BatchProgressBar"
                             Minimum="0" Maximum="100"
                             Height="6"
                             Foreground="#C9A84C"
                             Background="#2A2A2A"/>
              </StackPanel>

              <!-- Done status -->
              <TextBlock x:Name="BatchDoneLabel"
                         IsVisible="False"
                         FontSize="12" Foreground="#8A8580"
                         TextWrapping="Wrap"/>

              <!-- Export all -->
              <Button Classes="gold" Content="Export All…"
                      x:Name="BatchExportButton"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Click="OnBatchExportClick"/>

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

    </Grid>
  </Grid>
</Window>
